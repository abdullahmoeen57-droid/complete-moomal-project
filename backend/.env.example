# Copy to .env next to main.py (on the server: /home/moomaledu/moomal_backend/.env)
# Generate a secret with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password-12plus-chars

# Production settings for moomal.edu.pk
FRONTEND_ORIGINS=https://moomal.edu.pk,https://www.moomal.edu.pk
COOKIE_SECURE=true
ENABLE_API_DOCS=false
ACCESS_TOKEN_MINUTES=60

# Leave unset to use the SQLite file next to main.py (moomal_college.db)
# DATABASE_URL=

# Set to true for ONE restart to reset the existing admin password to ADMIN_PASSWORD, then back to false.
ADMIN_RESET_PASSWORD=false
