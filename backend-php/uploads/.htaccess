# Uploaded images only. Never run scripts from this folder.
Options -Indexes -ExecCGI
<FilesMatch "\.(php|phtml|phar|php\d|pl|py|cgi|sh|htaccess)$">
    Require all denied
</FilesMatch>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
